{
  "name": "@zixcel/github-auth",
  "version": "0.1.1",
  "description": "Local-first GitHub OAuth Device Flow plans for Zixcel consumers",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE",
    "repository.toml",
    "LICENSE-MIT",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./schema": "./schemas/github-oauth-device-declaration-v1.schema.json"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mts && tsc -p tsconfig.json",
    "typecheck": "pnpm run build && tsc -p tsconfig.test.json",
    "test": "pnpm run build && node --test test/*.test.mts",
    "prepack": "pnpm run typecheck && pnpm test"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.29.3",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixcel/zixcel-github-auth.git"
  },
  "keywords": [
    "github-api",
    "oauth2",
    "device-flow",
    "authentication",
    "typescript"
  ]
}
